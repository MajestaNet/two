# Copy to .env on the development host. Never commit .env.
# Placeholders only — no real hostnames, tokens, or model paths.

# Default 24 GB / 16K reference. Larger Macs: see `devflow profiles`.
DEVFLOW_INFERENCE_PROFILE=m24-qwen38-16k
# DEVFLOW_INFERENCE_CATALOG=config/inference/profiles.yaml

# Dummy key required by OpenAI-compatible clients. Ollama ignores it.
MAC_QWEN_API_KEY=ollama

# Private-network Ollama endpoint. Replace with your LAN hostname.
# Do not bind this to a public interface.
MAC_QWEN_BASE_URL=http://mac-inference.internal:11434/v1

# DevFlow control API. Loopback or Unix socket only by default.
DEVFLOW_API_BIND=127.0.0.1
DEVFLOW_API_PORT=8741
# DEVFLOW_API_SOCKET=/var/run/devflow/api.sock

# Optional Slack Socket Mode adapter. Leave empty unless enabled.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Local state directories (gitignored). Keep these outside target repos.
DEVFLOW_DATA_DIR=./var/devflow
DEVFLOW_WORKSPACE_ROOT=./var/worktrees
