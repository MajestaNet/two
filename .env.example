# Copy to .env on the development host. Never commit .env.
# Placeholders only — no real hostnames, tokens, or model paths.
# Operator walkthrough: docs/setup.md (privacy and network first).

# --- Topology and inference (catalogs in git; this file picks one) ---
# Default 24 GB / 16K reference. Larger Macs: see `two profiles`.
TWO_INFERENCE_PROFILE=m24-qwen38-16k
# split = Mac appliance + Linux host. colocated = one large Mac, loopback Ollama.
TWO_TOPOLOGY=split
# TWO_INFERENCE_CATALOG=config/inference/profiles.yaml

# --- Mac Ollama (private network only) ---
# Dummy key required by OpenAI-compatible clients. Ollama ignores it. Not a secret.
MAC_QWEN_API_KEY=ollama
# Replace with your LAN or Tailscale hostname. Never a public DNS name or 0.0.0.0.
# colocated: http://127.0.0.1:11434/v1
MAC_QWEN_BASE_URL=http://mac-inference.internal:11434/v1

# --- Majesta Two control API ---
# Loopback or Unix socket only by default (local-trust). Do not bind a public interface.
TWO_API_BIND=127.0.0.1
TWO_API_PORT=8741
# TWO_API_SOCKET=/var/run/two/api.sock
# Required when TWO_API_BIND is not loopback (for example a Tailscale IP).
# Never commit the real token. CLI: two task show ID --token …
# TWO_API_TOKEN=

# --- Optional messaging adapter (Slack is the MVP). Leave empty to run backend-only. ---
# Tokens stay on the development host. Never pass them to DSH, Qwen, or target repos.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Local state (gitignored). Keep outside target repositories. Mode 0700. ---
TWO_DATA_DIR=./var/two
TWO_WORKSPACE_ROOT=./var/worktrees
