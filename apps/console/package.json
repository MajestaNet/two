{
  "name": "two-console",
  "private": true,
  "version": "0.1.0",
  "description": "Majesta Two local operator console. Loopback only.",
  "license": "Apache-2.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/bridge.test.cjs",
    "stage-bundle": "bash scripts/stage-bundle.sh",
    "package": "npm run stage-bundle && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "net.majesta.two.console",
    "productName": "Majesta Two",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/mlx_hub.py",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bundle",
        "to": "bundle"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ]
    }
  }
}
